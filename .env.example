# HeistBox server configuration. Copy to .env (git-ignored). Every variable is optional.
# All money in this project is PLAY MONEY. No real payment rail is reachable from this code.

# --- server ---
HEISTBOX_HOST=127.0.0.1
HEISTBOX_PORT=8787

# --- database ---
# Leave unset to use the bundled embedded Postgres (pgserver) under db/pgdata.
# Set HEISTBOX_PGDATA to point the embedded server at another directory (fresh DB per run).
# HEISTBOX_DATABASE_URL=postgresql://user:pass@localhost:5432/heistbox
# HEISTBOX_PGDATA=./db/pgdata

# --- agent brains: Claude first, then Ollama, then canned offline lines ---
# Without ANTHROPIC_API_KEY the server skips Claude. With neither backend reachable it
# reports offline_mode=true in /api/health and agents use canned responses.
ANTHROPIC_API_KEY=
# HEISTBOX_CLAUDE_MODEL=claude-opus-5-5
# HEISTBOX_CLAUDE_EFFORT=low
# HEISTBOX_OLLAMA_URL=http://localhost:11434
# HEISTBOX_OLLAMA_MODEL=llama3.1:8b

# Force canned responses regardless of backends (useful for offline demos and tests).
# HEISTBOX_OFFLINE=1

# --- game tuning ---
# HEISTBOX_ROUND_SECONDS=240       # four equal weather phases per round
# HEISTBOX_THINK_LOOP=1            # ambient agent chatter while a client is connected
# HEISTBOX_RATE_LIMIT_ATTACKS=6    # attacks per window per session
# HEISTBOX_RATE_LIMIT_WINDOW_S=60
# HEISTBOX_SESSIONS_PER_MIN=10     # session creations per minute per client address

# --- web UI (Vite) ---
# VITE_API_BASE=                   # empty = same origin via the Vite dev proxy

# --- sponsor integrations (integrations/router.py, mounted at /api/integrations) ---
# Every one is optional: a missing or failing service shows an "offline" badge in GET /api/integrations/status
# and the game uses its fallback. Keys stay on the server; never put them in a VITE_* / NEXT_PUBLIC_* variable.
# See README.md for what each one does and its fallback.

# Wajo AI voice escalation (integrations/wajo_call.py). Fo phones the CFO when a >= $5,000 transfer is quarantined.
WAJO_API_KEY=
# wajo_api_key=                    # legacy lowercase spelling, still accepted
WAJO_MCP_URL=
CFO_ALERT_PHONE_NUMBER=
# WAJO_TIMEOUT_S=10                # dispatch budget; read-only probes use 3s
# WAJO_MIN_CALL_INTERVAL_S=300     # at most one live call per window
# WAJO_DRY_RUN=1                   # record escalations in the audit log without phoning anyone
# SETTLE_PAGE_URL=http://localhost:3000/settle
# CHALLENGE_CALLBACK_URL=http://localhost:8000/api/integrations/webauthn/verify

# LLMs (Claude is above). Gemini is the kernel extractor's second choice; OpenAI is not used by any code path.
GEMINI_API_KEY=
GEMINI_API_REMIX_KEY=                  # Gemini Multimodal Image Remix for Wanted Posters (gemini-2.5-flash-image)
# GEMINI_TEXT_MODEL=gemini-flash-latest
# GOOGLE_CLOUD_VISION_API_KEY=     # falls back to GEMINI_API_KEY for Cloud Vision
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5 # kernel extractor, poster roast, voice bribe
# HEISTBOX_LLM_TIMEOUT_S=8
# OLLAMA_HOST=http://127.0.0.1:11434   # kernel parsers (heistguard-lora); the server brain uses HEISTBOX_OLLAMA_URL
# HEISTGUARD_LIVE_OLLAMA=1
# HEISTGUARD_OLLAMA_MODEL=heistguard-lora
BITDEER_API_KEY=
# BITDEER_BASE_URL=https://api.bitdeer.ai/v1/chat/completions

# Voice
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# CARTESIA_MODEL_ID=sonic-2

# Moss semantic attack index
MOSS_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# MOSS_ATTACK_INDEX=heistbox-attacks

# CRS credit sandbox (StitchCredit): the login is what authenticates, not CRS_API_KEY
CRS_API_KEY=
CRS_USERNAME=
CRS_PASSWORD=
# CRS_BASE_URL=https://api-sandbox.stitchcredit.com/api

# x402 on Base Sepolia (TESTNET ONLY) and Coinbase Developer Platform (scripts/setup_x402_wallet.py faucet)
X402_SIGNER_PRIVATE_KEY=
X402_TESTNET_SCALE=
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
testnet_coinbase_base_api_key=
testnet_coinbase_base_api_secret=
BASESCAN_API_KEY=

# OSINT / scraping (never triggered automatically: Apify runs only with payload.apify=true)
APIFY_API_TOKEN=
BRIGHTDATA_API_KEY=
# BRIGHTDATA_SERP_ZONE=
# OSINT_USER_AGENT=HeistBox research contact security@example.com

# Factory droid CLI (npm install -g droid)
FACTORY_API_KEY=

# SpacetimeDB telemetry (the reducer call needs SPACETIMEDB_TOKEN; without it sync reports a local fallback)
SPACETIMEDB_URI=
SPACETIMEDB_id=
SPACETIMEDB_TOKEN=

# Fetch.ai guardian (in-process; uagents SDK optional)
# FETCH_AGENT_SEED=heistbox_guardian_seed

# WebAuthn: extra origins allowed to approve settlements (tunnels on *.trycloudflare.com / ngrok are allowed)
# WEBAUTHN_ALLOWED_ORIGINS=
